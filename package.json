{
  "name": "morosystems-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Automated GUI and API tests for the MoroSystems Automation Tester test case (Playwright + TypeScript)",
  "author": "Josef Číhal",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "playwright test --project=api --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "report": "playwright show-report",
    "backend:start": "node scripts/setup-backend.mjs && npm --prefix .backend/todo-be start",
    "api:generate": "node scripts/update-openapi-spec.mjs && openapi-ts -i ./openapi/todo-api.json -o src/api/todo/generated -c @hey-api/client-fetch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
